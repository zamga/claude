{
  "name": "plimsoll",
  "private": true,
  "version": "1.0.0",
  "description": "Plimsoll — a company analysis and valuation instrument. The price is sea level; your beliefs are the terrain.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && NODE_ENV=production node scripts/prerender.mjs",
    "build:artifact": "vite build --mode artifact && node scripts/package-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL=1 playwright test e2e/visual.spec.ts",
    "test:visual:update": "VISUAL=1 playwright test e2e/visual.spec.ts --update-snapshots",
    "data:refresh": "node --experimental-strip-types scripts/refresh-data.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:fast": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && NODE_ENV=production node scripts/prerender.mjs",
    "budget": "node scripts/budget.mjs",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "fonts": "python3 scripts/fonts.py"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "web-vitals": "6.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
