# Copy to .env (never commit it) or set these in your host's environment.

# The research engine. Without a key the server runs the site with the engine off.
ANTHROPIC_API_KEY=

# A live engine spends money on every run, so it needs access codes (comma-separated)...
UNCOVERED_ACCESS_CODES=
# ...or, to accept runs from anyone, UNCOVERED_OPEN=1.
UNCOVERED_OPEN=

# live (default with a key), off, or fixture: a scripted test run on a fictional company, no key needed.
UNCOVERED_ENGINE=

# The public address, for canonical links, the sitemap and the engine's user agent.
SITE_URL=

PORT=8080
UNCOVERED_DATA_DIR=data
UNCOVERED_MAX_CONCURRENT=2
UNCOVERED_RATE_LIMIT=3
UNCOVERED_RUN_MINUTES=30
# Set to 1 behind a reverse proxy, so rate limits apply per visitor rather than per proxy.
UNCOVERED_TRUST_PROXY=
