# Stock Picks environment template — names only, never commit values (spec page 61).
# Client-visible variables must be prefixed with VITE_.

# demo | live. Demo uses deterministic fixtures stored in this browser; live requires every
# variable below and refuses to start without them.
VITE_DATA_MODE=demo
# Public origin, used for the sitemap, robots.txt and canonical links (no trailing slash).
VITE_APP_URL=http://localhost:5173
# Comma-separated sign-in providers whose callback flows are configured, e.g. google,apple.
VITE_AUTH_PROVIDERS=

# Live mode (CONFIGURATION REQUIRED — not provisioned in this repository)
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Server-side only (never exposed to the client bundle)
# SESSION_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# MARKET_PROVIDER_KEY=
# EMAIL_API_KEY=
# VAPID_PRIVATE_KEY=
# BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
